# Copy this file to .env and fill in real values. Never commit .env.

# --- AlienVault OTX (free key from https://otx.alienvault.com/api) ---
OTX_API_KEY=

# --- Database ---
DATABASE_URL=sqlite:///./cti.db

# --- Web server ---
HOST=127.0.0.1
PORT=8000

# --- Scoring threshold (IOCs scoring below this are logged but not stored) ---
RELEVANCE_SCORE_THRESHOLD=40

# --- GeoIP (download GeoLite2-Country.mmdb from MaxMind, see README) ---
GEOIP_DB_PATH=./data/GeoLite2-Country.mmdb

# --- Logging ---
LOG_LEVEL=INFO
